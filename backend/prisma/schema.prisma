// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id       Int           @id @default(autoincrement())
  nombre   RolNombreEnum @unique
  slug     String        @unique
  usuarios Usuario[]
}

enum RolNombreEnum {
  USUARIO
  MODERADOR
  ADMIN
}

model Usuario {
  id                 Int               @id @default(autoincrement())
  nombre             String
  username           String            @unique
  email              String            @unique
  password           String?
  biografia          String?
  rol_id             Int
  rol                Rol               @relation(fields: [rol_id], references: [id])
  estado             UsuarioEstadoEnum @default(ACTIVO)
  createdAt          DateTime          @default(now())
  avatarURL          String?
  carpetas           Carpeta[]
  posts              Post[]
  postGuardados      PostGuardado[]
  deletedAt          DateTime?
  passwordResetNonce String?

  provider   String?
  providerId String?

  likes       Like[]
  comentarios Comentario[]

  seguidores Seguidor[] @relation("Seguidores")
  seguidos   Seguidor[] @relation("Seguidos")
}

enum UsuarioEstadoEnum {
  ACTIVO
  SILENCIADO
  BLOQUEADO
  SUSPENDIDO
}

model Tecnologia {
  id         Int     @id @default(autoincrement())
  nombre     String  @unique
  background String?
  border     String?
  text       String?

  posts Post[]
}

model Carpeta {
  id            Int            @id @default(autoincrement())
  usuario_id    Int
  usuario       Usuario        @relation(fields: [usuario_id], references: [id])
  nombre        String         @default("FAVORITOS")
  createdAt     DateTime       @default(now())
  postGuardados PostGuardado[]

  @@unique([usuario_id, nombre])
}

model Post {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  usuario    Usuario  @relation(fields: [usuario_id], references: [id])
  contenido  String   @db.VarChar(280)
  createdAt  DateTime @default(now())

  tecnologias   Tecnologia[]
  postGuardados PostGuardado[]
  likes         Like[]
  comentarios   Comentario[]
}

model PostGuardado {
  id         Int      @id @default(autoincrement())
  post_id    Int
  carpeta_id Int
  usuario_id Int
  createdAt  DateTime @default(now())

  post    Post    @relation(fields: [post_id], references: [id])
  carpeta Carpeta @relation(fields: [carpeta_id], references: [id])
  usuario Usuario @relation(fields: [usuario_id], references: [id])

  @@unique([post_id, carpeta_id])
  @@index([usuario_id, carpeta_id])
}

model Like {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  post_id    Int
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  post    Post    @relation(fields: [post_id], references: [id])

  @@unique([usuario_id, post_id])
  @@index([post_id])
  @@index([usuario_id])
}

model Comentario {
  id         Int      @id @default(autoincrement())
  usuario_id Int
  post_id    Int
  contenido  String   @db.VarChar(280)
  parent_id  Int?
  createdAt  DateTime @default(now())

  usuario Usuario @relation(fields: [usuario_id], references: [id])
  post    Post    @relation(fields: [post_id], references: [id])

  parent     Comentario?  @relation("ComentarioRespuestas", fields: [parent_id], references: [id], onDelete: Cascade)
  respuestas Comentario[] @relation("ComentarioRespuestas")

  @@index([post_id])
  @@index([usuario_id])
  @@index([parent_id])
}

model Seguidor {
  id          Int      @id @default(autoincrement())
  seguidor_id Int
  seguido_id  Int
  createdAt   DateTime @default(now())

  seguidor Usuario @relation("Seguidores", fields: [seguidor_id], references: [id])
  seguido  Usuario @relation("Seguidos", fields: [seguido_id], references: [id])

  @@unique([seguidor_id, seguido_id])
  @@index([seguidor_id])
  @@index([seguido_id])
}
