generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Rol {
  id       Int           @id @default(autoincrement())
  nombre   RolNombreEnum @unique
  usuarios Usuario[]
}

enum RolNombreEnum {
  USUARIO
  MODERADOR
  ADMINISTRADOR
}

  model Usuario {
    id        Int               @id @default(autoincrement())
    nombre    String
    username  String            @unique
    email     String            @unique
    password  String
    biografia String?
    rolId     Int               @default(2)
    rol       Rol               @relation(fields: [rolId], references: [id])
    estado    UsuarioEstadoEnum @default(ACTIVO)
    createdAt DateTime          @default(now())
    avatarURL String?
  }

enum UsuarioEstadoEnum {
  ACTIVO
  SILENCIAD
  BLOQUEADO
  SUSPENDIDO
}
